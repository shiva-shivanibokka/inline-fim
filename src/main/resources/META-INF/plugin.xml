<idea-plugin>
    <id>dev.inlinefim</id>
    <name>Inline FIM</name>
    <vendor>shivani-bokka</vendor>
    <description><![CDATA[
        <p>Local fill-in-the-middle code completion, rendered inline as you type.</p>
        <p>Sends the code before and after your caret to a FIM-trained model running
        locally under Ollama, and offers the middle. No API key, no network, no
        code leaving the machine.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <inline.completion.provider
            id="dev.inlinefim.InlineFimProvider"
            implementationClass="dev.inlinefim.InlineFimProvider"/>

        <!-- Pays the ~4.5s cold model load at startup rather than on the user's
             first keystroke. Failure is silent and harmless. -->
        <postStartupActivity implementation="dev.inlinefim.FimWarmup"/>

        <applicationConfigurable
            parentId="tools"
            id="dev.inlinefim.settings"
            displayName="Inline FIM"
            instance="dev.inlinefim.FimConfigurable"/>
    </extensions>

    <applicationListeners>
        <listener
            class="dev.inlinefim.TelemetryInstaller"
            topic="com.intellij.codeInsight.inline.completion.InlineCompletionInstallListener"/>
    </applicationListeners>
</idea-plugin>
